      "source": [
        "text = \"HELLO\"\n",
        "pattern = \"LL\"\n",
        "\n",
        "n = len(text)\n",
        "m = len(pattern)\n",
        "\n",
        "print(\"Pattern found at positions:\")\n",
        "\n",
        "for i in range(n - m + 1):\n",
        "    if text[i:i + m] == pattern:\n",
        "        print(i)"
      ]
